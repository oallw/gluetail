# gluetail node "mullvad": a VPN exit node (untested until a funded account is available).
# credentials file containing WIREGUARD_PRIVATE_KEY=... and WIREGUARD_ADDRESSES=...
GLUETAIL_SECRETS=./secrets/mullvad.env
GLUETAIL_HOSTNAME=exit-mullvad
VPN_SERVICE_PROVIDER=mullvad
VPN_TYPE=wireguard
SERVER_COUNTRIES=Sweden
