# gluetail node "proton": a VPN exit node. Everything except GLUETAIL_* is passed
# to gluetun as-is, so any gluetun option for your provider works here
# (see https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers).
GLUETAIL_SECRETS=./secrets/proton.env     # file with WIREGUARD_PRIVATE_KEY=...
GLUETAIL_HOSTNAME=exit-proton             # name in your tailnet
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
SERVER_COUNTRIES=Netherlands
FREE_ONLY=on                              # Proton free plan; remove on a paid plan
