#!/usr/bin/env python3
"""gluetail: inspect and control gluetail exit nodes (stdlib only).

Nodes are the gluetun containers labelled `gluetail.node=<name>`. The CLI talks
to each one's control API directly over the `gluetail` Docker network, so it
needs the Docker CLI but no Docker socket exposure and no published ports.
"""
import argparse
import difflib
import json
import os
import re
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from dataclasses import dataclass
from typing import Optional

LABEL = "gluetail.node"
NETWORK = "gluetail"
API_PORT = 8000


class GluetailError(Exception):
    pass


@dataclass
class Node:
    name: str
    container: str
    state: str
    host: Optional[str]  # control API address: container IP (docker mode) or name (file mode)
    provider: str
    free_only: bool
    working_dir: Optional[str]
    servers_json: Optional[str]


def run_docker(*args):
    try:
        done = subprocess.run(["docker", *args], check=True, capture_output=True, text=True)
    except FileNotFoundError:
        raise GluetailError("docker CLI not found")
    except subprocess.CalledProcessError as e:
        raise GluetailError(f"docker {args[0]} failed: {e.stderr.strip()}")
    return done.stdout


def parse_node(inspect):
    """Build a Node from `docker inspect` output, keeping only non-secret fields."""
    cfg = inspect["Config"]
    labels = cfg.get("Labels") or {}
    env = {}
    for item in cfg.get("Env") or []:
        key, _, value = item.partition("=")
        if key in ("VPN_SERVICE_PROVIDER", "FREE_ONLY"):
            env[key] = value
    net = (inspect["NetworkSettings"]["Networks"] or {}).get(NETWORK) or {}
    data_dir = next((m["Source"] for m in inspect.get("Mounts", []) if m["Destination"] == "/gluetun"), None)
    name = labels[LABEL]
    return Node(
        name=name,
        container=inspect["Name"].lstrip("/"),
        state=inspect["State"]["Status"],
        host=net.get("IPAddress") or None,
        provider=env.get("VPN_SERVICE_PROVIDER", ""),
        free_only=env.get("FREE_ONLY", "").lower() in ("on", "yes", "true", "1"),
        working_dir=labels.get("com.docker.compose.project.working_dir"),
        servers_json=os.path.join(data_dir, "servers.json") if data_dir else None,
    )


def discover_nodes():
    ids = run_docker("ps", "-aq", "--filter", f"label={LABEL}").split()
    if not ids:
        return []
    nodes = [parse_node(i) for i in json.loads(run_docker("inspect", *ids))]
    return sorted(nodes, key=lambda n: n.name)


def get_node(name):
    nodes = discover_nodes()
    for n in nodes:
        if n.name == name:
            return n
    known = ", ".join(n.name for n in nodes) or "none found (is the stack up?)"
    raise GluetailError(f"unknown node '{name}'; known nodes: {known}")


def decode_body(raw):
    """Control API replies are JSON, except settings updates which return plain text."""
    text = raw.decode(errors="replace").strip()
    try:
        return json.loads(text)
    except ValueError:
        return text


def api(node, method, path, body=None, timeout=5):
    if not node.host:
        raise GluetailError(f"{node.name}: container is not running on the '{NETWORK}' network")
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(f"http://{node.host}:{API_PORT}{path}", data=data, method=method,
                                 headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return decode_body(resp.read())
    except urllib.error.HTTPError as e:
        raise GluetailError(f"{node.name}: {method} {path} -> HTTP {e.code}")
    except (urllib.error.URLError, OSError) as e:
        raise GluetailError(f"{node.name}: control API unreachable ({e})")


def node_status(node):
    out = {"node": node.name, "container": node.state, "provider": node.provider}
    try:
        out["vpn"] = api(node, "GET", "/v1/vpn/status")["status"]
        ip = api(node, "GET", "/v1/publicip/ip")
        out.update(public_ip=ip.get("public_ip"), country=ip.get("country"), city=ip.get("city"))
    except GluetailError as e:
        out["error"] = str(e)
    return out


def list_countries(servers, provider, free_only):
    if provider not in servers:
        raise GluetailError(f"provider '{provider}' not found in gluetun's server list")
    found = {
        s["country"]
        for s in servers[provider]["servers"]
        if s.get("vpn") == "wireguard" and (s.get("free") or not free_only)
    }
    return sorted(found)


def resolve_countries(requested, available):
    by_lower = {c.lower(): c for c in available}
    out = []
    for name in requested:
        match = by_lower.get(name.lower())
        if not match:
            close = difflib.get_close_matches(name.lower(), list(by_lower), n=3, cutoff=0.6)
            hint = f" Did you mean: {', '.join(by_lower[c] for c in close)}?" if close else ""
            raise GluetailError(f"'{name}' is not available.{hint} Run `gluetail options <node>` to see what is available.")
        out.append(match)
    return out


def node_countries(node):
    if not node.servers_json or not os.path.exists(node.servers_json):
        raise GluetailError(f"{node.name}: gluetun server list not found (has the node started once?)")
    with open(node.servers_json) as f:
        return list_countries(json.load(f), node.provider, node.free_only)


NODE_NAME_RE = re.compile(r"^[a-z][a-z0-9-]{0,30}$")
HOSTNAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9-]{0,62}$")
TS_ARGS_RE = re.compile(r"^[A-Za-z0-9=,:._ /-]*$")
PORT_RE = re.compile(r"^(?:(?:\d{1,3}\.){3}\d{1,3}:)?(\d{1,5}):(\d{1,5})(?:/(?:tcp|udp))?$")
SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))


def parse_env_text(text):
    """Parse dotenv-style text into a dict (no interpolation, optional quotes)."""
    out = {}
    for n, raw in enumerate(text.splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        key, sep, value = line.partition("=")
        key, value = key.strip(), value.strip()
        if not sep or not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key):
            raise GluetailError(f"line {n}: expected KEY=VALUE, got '{raw}'")
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        else:
            value = re.sub(r"(^|\s+)#.*$", "", value).strip()  # inline comment, as Compose does
        out[key] = value
    return out


def load_node_files(nodes_dir):
    nodes = {}
    for fname in sorted(os.listdir(nodes_dir)) if os.path.isdir(nodes_dir) else []:
        if not fname.endswith(".env"):
            continue
        name = fname[:-4]
        if not NODE_NAME_RE.match(name):
            raise GluetailError(f"{fname}: node name must match {NODE_NAME_RE.pattern}")
        with open(os.path.join(nodes_dir, fname)) as f:
            try:
                nodes[name] = parse_env_text(f.read())
            except GluetailError as e:
                raise GluetailError(f"{fname}: {e}")
    return nodes


def render_compose(nodes, template_dir):
    """Render docker-compose.yml text from parsed node settings."""
    def tpl(name):
        with open(os.path.join(template_dir, name)) as f:
            return f.read()

    parts = [tpl("header.yml")]
    vpn_nodes = []
    if not nodes:
        raise GluetailError("no nodes found: create nodes/<name>.env (see nodes/*.env.example)")
    for name, cfg in nodes.items():
        kind = cfg.get("GLUETAIL_TYPE", "vpn")
        if kind not in ("vpn", "direct"):
            raise GluetailError(f"{name}: GLUETAIL_TYPE must be 'vpn' or 'direct', got '{kind}'")
        hostname = cfg.get("GLUETAIL_HOSTNAME", f"exit-{name}")
        ts_args = cfg.get("GLUETAIL_TS_ARGS", "")
        secrets = cfg.get("GLUETAIL_SECRETS", f"./secrets/{name}.env")
        if not HOSTNAME_RE.match(hostname):
            raise GluetailError(f"{name}: invalid GLUETAIL_HOSTNAME '{hostname}'")
        if not TS_ARGS_RE.match(ts_args):
            raise GluetailError(f"{name}: GLUETAIL_TS_ARGS contains unsupported characters")
        for label, value in (("GLUETAIL_SECRETS", secrets), ("GLUETAIL_TS_ARGS", ts_args)):
            if "$" in value or any(c in value for c in "\r\n\0"):
                raise GluetailError(f"{name}: {label} must not contain '$' or control characters")
        if kind == "vpn" and "VPN_SERVICE_PROVIDER" not in cfg:
            raise GluetailError(f"{name}: VPN nodes need VPN_SERVICE_PROVIDER (e.g. protonvpn, mullvad)")
        if kind == "vpn":
            vpn_nodes.append(name)
        text = tpl(f"{kind}.yml")
        ports = [p.strip() for p in cfg.get("GLUETAIL_PORTS", "").split(",") if p.strip()]
        for port in ports:
            m = PORT_RE.match(port)
            if m and m.group(2) == "8000" and not port.startswith("127.0.0.1:"):
                raise GluetailError(f"{name}: GLUETAIL_PORTS entry '{port}' would expose gluetun's control API "
                                    "(it can change VPN settings); bind it to loopback: 127.0.0.1:<port>:8000")
            if not m or not all(0 < int(g) < 65536 for g in m.groups()):
                raise GluetailError(f"{name}: invalid GLUETAIL_PORTS entry '{port}' "
                                    "(use [bind-ip:]host:container[/tcp|/udp], e.g. 9080:8080 or 127.0.0.1:9800:8000)")
        if ports and kind != "vpn":
            raise GluetailError(f"{name}: GLUETAIL_PORTS only applies to VPN nodes")
        block = "    ports:\n" + "".join(f"      - {json.dumps(p)}\n" for p in ports) if ports else ""
        text = text.replace("@@PORTS@@\n", block)
        for key, value in (("@@NAME@@", name), ("@@HOSTNAME@@", hostname), ("@@TS_ARGS@@", ts_args),
                           ("@@SECRETS@@", json.dumps(secrets))):
            text = text.replace(key, value)
        parts.append(text)
    if vpn_nodes:
        mounts = "".join(f"      - ${{GLUETAIL_DATA_DIR:-./data}}/{n}/gluetun:/data/{n}/gluetun:ro\n" for n in vpn_nodes)
        parts.append(tpl("ui.yml").replace("@@NODE_MOUNTS@@\n", mounts))
    return "".join(parts)


def summarize_nodes(cfgs, container_states):
    rows = []
    for name, cfg in cfgs.items():
        kind = cfg.get("GLUETAIL_TYPE", "vpn")
        rows.append({
            "node": name,
            "type": kind,
            "hostname": cfg.get("GLUETAIL_HOSTNAME", f"exit-{name}"),
            "provider": cfg.get("VPN_SERVICE_PROVIDER", "-") if kind == "vpn" else "-",
            "countries": (cfg.get("SERVER_COUNTRIES") or "any") if kind == "vpn" else "-",
            "state": container_states.get(f"gluetail-ts-{name}", "not created"),
        })
    return rows


def resolve_name(arg, cfgs):
    """Accept a node name or its tailnet hostname (what the Tailscale app shows)."""
    if arg in cfgs:
        return arg
    for name, cfg in cfgs.items():
        if cfg.get("GLUETAIL_HOSTNAME", f"exit-{name}") == arg:
            return name
    return arg


def pick_vpn_node(arg, cfgs):
    vpn = [n for n, c in cfgs.items() if c.get("GLUETAIL_TYPE", "vpn") == "vpn"]
    listing = ", ".join(vpn) or "none configured"
    if arg is None:
        if len(vpn) == 1:
            return vpn[0]
        raise GluetailError(f"which node? VPN nodes: {listing} (see `gluetail nodes`)")
    name = resolve_name(arg, cfgs)
    if name in cfgs and name not in vpn:
        raise GluetailError(f"'{name}' is a direct node with no VPN, so it has no country to change")
    if name not in vpn:
        raise GluetailError(f"unknown node '{arg}'; VPN nodes: {listing} (see `gluetail nodes`)")
    return name


def container_states():
    out = run_docker("ps", "-a", "--filter", "name=gluetail-", "--format", "{{.Names}}\t{{.State}}")
    return dict(line.split("\t", 1) for line in out.splitlines() if "\t" in line)


def cmd_nodes(args):
    rows = summarize_nodes(load_node_files(os.path.join(args.root, "nodes")), container_states())
    if args.json:
        print(json.dumps(rows, indent=2))
        return 0
    if not rows:
        print("no nodes configured: copy nodes/*.env.example to nodes/<name>.env, then `gluetail render`")
        return 1
    print(f"{'NODE':<12} {'TYPE':<7} {'TAILNET NAME':<18} {'PROVIDER':<10} {'COUNTRIES':<22} STATE")
    for r in rows:
        print(f"{r['node']:<12} {r['type']:<7} {r['hostname']:<18} {r['provider']:<10} {r['countries']:<22} {r['state']}")
    return 0


def node_from_args(args):
    cfgs = load_node_files(os.path.join(args.root, "nodes"))
    return get_node(pick_vpn_node(args.node, cfgs))


def find_dependents(inspected, node_container, node_id):
    """Containers whose network namespace is the node's gluetun container (network_mode: container:...)."""
    out = []
    for c in inspected:
        mode = c.get("HostConfig", {}).get("NetworkMode", "")
        if not mode.startswith("container:"):
            continue
        target = mode[len("container:"):]
        if target == node_container or (len(target) >= 12 and (node_id.startswith(target) or target.startswith(node_id))):
            labels = c.get("Config", {}).get("Labels") or {}
            out.append({"container": c["Name"].lstrip("/"), "state": c["State"]["Status"],
                        "project": labels.get("com.docker.compose.project", "-"),
                        "service": labels.get("com.docker.compose.service", "-"), "labels": labels})
    return sorted(out, key=lambda d: d["container"])


def cmd_dependents(args):
    cfgs = load_node_files(os.path.join(args.root, "nodes"))
    name = pick_vpn_node(args.node, cfgs)
    gluetun = f"gluetail-gluetun-{name}"
    node_id = json.loads(run_docker("inspect", gluetun))[0]["Id"]
    ids = run_docker("ps", "-aq", "--no-trunc").split()
    deps = find_dependents(json.loads(run_docker("inspect", *ids)) if ids else [], gluetun, node_id)
    if args.json:
        print(json.dumps([{k: v for k, v in d.items() if k != "labels"} for d in deps], indent=2))
        return 0
    print(f"containers sharing {gluetun}'s network namespace (they lose connectivity if it is recreated; "
          f"recreate them afterwards):")
    for d in deps:
        print(f"  {d['container']:<28} {d['state']:<9} {d['project']}/{d['service']}")
    return 0


def snapshot_nodes(vpn_names):
    """For each VPN node: its gluetun container id and compose project, and who is attached to it."""
    ids = run_docker("ps", "-aq", "--no-trunc").split()
    inspected = json.loads(run_docker("inspect", *ids)) if ids else []
    by_name = {c["Name"].lstrip("/"): c for c in inspected}
    out = {}
    for name in vpn_names:
        c = by_name.get(f"gluetail-gluetun-{name}")
        if not c:
            out[name] = {"id": None, "project": None, "deps": []}
            continue
        project = (c["Config"].get("Labels") or {}).get("com.docker.compose.project")
        # containers of gluetail's own project (the Tailscale sidecar) are recreated by compose itself
        deps = [d for d in find_dependents(inspected, c["Name"].lstrip("/"), c["Id"]) if d["project"] != project]
        out[name] = {"id": c["Id"], "project": project, "deps": deps}
    return out


def plan_recreations(before, after):
    """(node, dependent) pairs for nodes whose gluetun container was replaced during `up`."""
    steps = []
    for node, b in before.items():
        a = after.get(node)
        if b["id"] and a and a["id"] and a["id"] != b["id"]:
            steps += [(node, d) for d in b["deps"]]
    return steps


def recreate_commands(steps):
    """Group dependents by compose project into `docker compose up -d --force-recreate --no-deps` commands.

    Returns (commands, unmanaged): commands are (argv, [container names]); unmanaged are dependents that
    carry no compose labels and so cannot be recreated automatically."""
    groups, unmanaged = {}, []
    for node, d in steps:
        lab = d["labels"]
        key = tuple(lab.get(f"com.docker.compose.{k}") for k in ("project", "project.working_dir", "project.config_files"))
        service = lab.get("com.docker.compose.service")
        if not all(key) or not service:
            unmanaged.append(d["container"])
            continue
        entry = groups.setdefault(key, {"services": [], "names": []})
        if service not in entry["services"]:
            entry["services"].append(service)
        entry["names"].append(d["container"])
    commands = []
    for (project, workdir, files), entry in groups.items():
        argv = ["docker", "compose", "--project-directory", workdir, "-p", project]
        for f in files.split(","):
            argv += ["-f", f]
        commands.append((argv + ["up", "-d", "--force-recreate", "--no-deps"] + entry["services"], entry["names"]))
    return commands, unmanaged


def cmd_up(args):
    cfgs = load_node_files(os.path.join(args.root, "nodes"))
    vpn = [n for n, c in cfgs.items() if c.get("GLUETAIL_TYPE", "vpn") == "vpn"]
    compose = ["docker", "compose", "up", "-d", "--remove-orphans"] + (["--force-recreate"] if args.force_recreate else [])
    if args.dry_run:
        before = snapshot_nodes(vpn)
        print("would render docker-compose.yml, then run: " + " ".join(compose))
        for node, info in before.items():
            names = ", ".join(d["container"] for d in info["deps"]) or "none"
            print(f"  node {node}: attached containers (recreated afterwards if the node is replaced): {names}")
        return 0
    cmd_render(args)
    before = snapshot_nodes(vpn)
    rc = subprocess.run(compose, cwd=args.root).returncode
    if rc:
        print(f"error: docker compose up failed (exit {rc}); attached containers were not touched", file=sys.stderr)
        return rc
    if args.no_dependents:
        return 0
    steps = plan_recreations(before, snapshot_nodes(vpn))
    if not steps:
        return 0
    commands, unmanaged = recreate_commands(steps)
    failed = []
    for argv, names in commands:
        print(f"recreating {', '.join(names)} (their VPN node was replaced)")
        if subprocess.run(argv).returncode:
            failed.append(names)
    if unmanaged:
        print(f"warning: not managed by compose, recreate by hand: {', '.join(unmanaged)}", file=sys.stderr)
    if failed:
        print(f"error: could not recreate: {', '.join(n for names in failed for n in names)}", file=sys.stderr)
        return 1
    return 1 if unmanaged else 0


def cmd_render(args):
    root = args.root
    text = render_compose(load_node_files(os.path.join(root, "nodes")), os.path.join(root, "templates"))
    out = os.path.join(root, "docker-compose.yml")
    with open(out, "w") as f:
        f.write(text)
    print(f"wrote {out}")
    return 0


# --- provider schema: generated from gluetun's own server list ---------------
# Server attribute -> (API key, env var, label). Everything else is derived:
# an attribute whose values are all True becomes a toggle "<attr>_only"/"<ATTR>_ONLY".
SERVER_FIELDS = {
    "country": ("countries", "SERVER_COUNTRIES", "Country"),
    "region": ("regions", "SERVER_REGIONS", "Region"),
    "city": ("cities", "SERVER_CITIES", "City"),
    "isp": ("isps", "ISP", "ISP"),
}
FLAG_NAME_EXCEPTIONS = {"multihop": "multi_hop"}
NON_FILTER_FIELDS = {"vpn", "ips", "tcp", "udp", "wgpubkey", "hostname", "server_name", "number", "port",
                     "categories", "port_forward_ports"}
PLAN_FIELD = "free"
# Geography is a hierarchy: a child (city) never narrows its parent's options, so picking a
# city does not lock you out of other countries. Other filters (ISP, toggles) apply both ways.
GEO_CHILDREN = {"countries": {"regions", "cities"}, "regions": {"cities"}}
TRUTHY = ("on", "yes", "true", "1")


def build_facets(servers):
    """Derive filter controls from a provider's server list. Returns (facets, unsupported)."""
    seen = {}
    for srv in servers:
        for field, value in srv.items():
            seen.setdefault(field, []).append(value)
    facets = [
        {"field": f, "key": k, "env": e, "label": lbl, "kind": "multi"}
        for f, (k, e, lbl) in SERVER_FIELDS.items() if f in seen
    ]
    unsupported = []
    for field in sorted(seen):
        if field in SERVER_FIELDS or field in NON_FILTER_FIELDS:
            continue
        if all(v is True for v in seen[field]):
            name = FLAG_NAME_EXCEPTIONS.get(field, field)
            facets.append({"field": field, "key": f"{name}_only", "env": f"{name.upper()}_ONLY",
                           "label": field.replace("_", " ").capitalize(),
                           "kind": "plan" if field == PLAN_FIELD else "bool"})
        else:
            unsupported.append(field)
    return facets, unsupported


def server_matches(server, selection, facets, skip=()):
    skip = {skip} if isinstance(skip, str) else set(skip)
    for f in facets:
        if f["key"] in skip or f["kind"] == "plan":
            continue
        want = selection.get(f["key"])
        if not want:
            continue
        if f["kind"] == "multi":
            if str(server.get(f["field"], "")).lower() not in {v.lower() for v in want}:
                return False
        elif not server.get(f["field"]):
            return False
    return True


def compute_options(servers, facets, unsupported, selection, free_plan):
    """Faceted view of what can still be chosen, given the current selection and plan."""
    base = [s for s in servers if s.get(PLAN_FIELD) or not free_plan]
    out = []
    for f in facets:
        if f["kind"] == "plan":
            continue
        skip = {f["key"]} | GEO_CHILDREN.get(f["key"], set())
        others = [s for s in base if server_matches(s, selection, facets, skip=skip)]
        entry = {"key": f["key"], "env": f["env"], "label": f["label"], "kind": f["kind"],
                 "selected": selection.get(f["key"]) or ([] if f["kind"] == "multi" else False)}
        if f["kind"] == "multi":
            counts = {}
            for s in others:
                if f["field"] in s:
                    counts[s[f["field"]]] = counts.get(s[f["field"]], 0) + 1
            entry["options"] = [{"value": v, "count": c} for v, c in sorted(counts.items())]
        else:
            entry["count"] = sum(1 for s in others if s.get(f["field"]))
            if not entry["count"]:
                entry["disabled_reason"] = "no servers on your plan" if free_plan else "no matching servers"
        out.append(entry)
    match_count = sum(1 for s in base if server_matches(s, selection, facets))
    return {"plan": "free" if free_plan else "all", "match_count": match_count, "facets": out,
            "unsupported": unsupported}


def prune_selection(servers, facets, unsupported, selection, free_plan):
    """Drop selected regions/cities that the chosen parents no longer offer; report what was dropped."""
    sel = {k: list(v) if isinstance(v, list) else v for k, v in selection.items()}
    removed = {}
    for key in ("regions", "cities"):
        if not sel.get(key):
            continue
        entry = next((e for e in compute_options(servers, facets, unsupported, sel, free_plan)["facets"]
                      if e["key"] == key), None)
        if entry is None:
            continue
        valid = {o["value"].lower() for o in entry["options"]}
        gone = [v for v in sel[key] if v.lower() not in valid]
        if gone:
            removed[key] = gone
            sel[key] = [v for v in sel[key] if v.lower() in valid]
    return sel, removed


def selection_from_env(env, facets):
    sel = {}
    for f in facets:
        raw = env.get(f["env"], "")
        if f["kind"] == "multi":
            sel[f["key"]] = [v.strip() for v in raw.split(",") if v.strip()]
        elif f["kind"] == "bool":
            sel[f["key"]] = raw.strip().lower() in TRUTHY
    return sel


def parse_changes(items, facets, options):
    """Turn ['countries=Japan', 'secure_core_only=on', 'cities='] into {key: list|bool}."""
    by_key = {f["key"]: f for f in facets if f["kind"] != "plan"}
    by_field = {f["field"]: f for f in by_key.values()}
    avail = {e["key"]: [o["value"] for o in e.get("options", [])] for e in options["facets"]}
    changes = {}
    for item in items:
        key, sep, value = item.partition("=")
        key = key.strip().lower()
        f = by_key.get(key) or by_field.get(key)
        if not sep or not f:
            known = ", ".join(sorted(by_key))
            raise GluetailError(f"bad filter '{item}': use key=value with key one of: {known}")
        if f["kind"] == "bool":
            if value.strip().lower() not in TRUTHY + ("off", "no", "false", "0", ""):
                raise GluetailError(f"{f['key']} must be on or off")
            changes[f["key"]] = value.strip().lower() in TRUTHY
        else:
            names = [v.strip() for v in value.split(",") if v.strip()]
            changes[f["key"]] = resolve_countries(names, avail.get(f["key"], [])) if names else []
    return changes


def describe_failure(options, changes):
    lines = []
    for e in options["facets"]:
        if e["key"] not in changes:
            continue
        if e["kind"] == "multi":
            opts = ", ".join(f"{o['value']}" for o in e["options"][:12]) or "none"
            lines.append(f"{e['label']} options with the other filters applied: {opts}")
        elif changes[e["key"]] and e.get("disabled_reason"):
            lines.append(f"{e['key']}: {e['disabled_reason']}")
    return "; ".join(lines)


def update_env_file(path, key, value):
    if any(c in value for c in "\r\n\0"):
        raise GluetailError("refusing to write a value containing control characters")
    lines = []
    if os.path.exists(path):
        with open(path) as f:
            lines = f.read().splitlines()
    new = f"{key}={value}"
    for i, line in enumerate(lines):
        if line.startswith(f"{key}="):
            lines[i] = new
            break
    else:
        lines.append(new)
    with open(path, "w") as f:
        f.write("\n".join(lines) + "\n")


def load_servers(node):
    if not node.servers_json or not os.path.exists(node.servers_json):
        raise GluetailError(f"{node.name}: gluetun server list not found (has the node started once?)")
    with open(node.servers_json) as f:
        doc = json.load(f)
    if node.provider not in doc:
        raise GluetailError(f"provider '{node.provider}' not found in gluetun's server list")
    return [s for s in doc[node.provider]["servers"] if s.get("vpn", "wireguard") == "wireguard"]


def node_file(node):
    if not node.working_dir:
        raise GluetailError(f"{node.name}: cannot find the compose directory")
    return os.path.join(node.working_dir, "nodes", f"{node.name}.env")


def node_view(node):
    """Everything the options/set logic needs, from the server list and the saved node file."""
    servers = load_servers(node)
    facets, unsupported = build_facets(servers)
    with open(node_file(node)) as f:
        env = parse_env_text(f.read())
    free_plan = env.get("FREE_ONLY", "").strip().lower() in TRUTHY
    return servers, facets, unsupported, selection_from_env(env, facets), free_plan


def get_options(node):
    servers, facets, unsupported, selection, free_plan = node_view(node)
    return compute_options(servers, facets, unsupported, selection, free_plan)


def _put_selection(node, values):
    return api(node, "PUT", "/v1/vpn/settings", {"provider": {"server_selection": values}})


def _wait_running(node, timeout, need_ip=True):
    """Wait until the VPN is up; with need_ip also until gluetun reports a public IP.

    Returns the IP info, {} when only 'running' could be confirmed (need_ip=False), or None on timeout."""
    deadline = time.time() + timeout
    while time.time() < deadline:
        time.sleep(2)
        try:
            if api(node, "GET", "/v1/vpn/status")["status"] == "running":
                ip = api(node, "GET", "/v1/publicip/ip")
                if ip.get("public_ip"):
                    return ip
                if not need_ip:
                    return {}
        except GluetailError:
            pass  # control API can blink while the VPN restarts
    return None


def _can_verify(node):
    """Whether gluetun's public-IP lookup works right now (it is our only proof the tunnel carries traffic)."""
    try:
        return bool(api(node, "GET", "/v1/publicip/ip").get("public_ip"))
    except (GluetailError, AttributeError):
        return False


def _norm(value):
    return sorted(v.lower() for v in value) if isinstance(value, list) else bool(value)


def set_filters(node, items, persist=True, timeout=90):
    servers, facets, unsupported, selection, free_plan = node_view(node)
    # names are validated against everything the plan offers; the combination is checked below
    changes = parse_changes(items, facets, compute_options(servers, facets, unsupported, {}, free_plan))
    new_sel = {**selection, **changes}
    after = compute_options(servers, facets, unsupported, new_sel, free_plan)
    if not after["match_count"]:
        raise GluetailError(f"no {after['plan']}-plan server matches that combination. "
                            + describe_failure(after, changes))
    # If gluetun's lookup was already failing before the change, it cannot prove anything afterwards
    # either: apply, wait for "running", and report the location as unverified instead of rolling back.
    verify = _can_verify(node)
    result = _put_selection(node, changes)
    if result == "settings left unchanged":
        return {"node": node.name, "unchanged": True, "selection": new_sel}
    ip = None if result == "crashed" else _wait_running(node, timeout, need_ip=verify)
    if ip is None:
        _put_selection(node, {k: selection[k] for k in changes})  # roll back to the saved selection
        back = _wait_running(node, timeout, need_ip=verify)
        raise GluetailError(f"{node.name}: the VPN did not come up with those filters; "
                            + ("rolled back to the previous selection" if back else
                               "rollback also pending (gluetun retries with growing delays), check `gluetail status`"))
    if persist:
        by_key = {f["key"]: f for f in facets}
        for key, value in changes.items():
            if _norm(value) == _norm(selection.get(key)):
                continue  # unchanged: do not litter the node file with empty keys
            text = ",".join(value) if isinstance(value, list) else ("on" if value else "")
            update_env_file(node_file(node), by_key[key]["env"], text)
    return {"node": node.name, "unchanged": False, "selection": new_sel, "verified": bool(ip),
            "public_ip": ip.get("public_ip"), "country": ip.get("country"), "city": ip.get("city"),
            "persisted": persist}


def node_from_files(root, data_dir, name):
    """Build a VPN Node from nodes/<name>.env only, with no Docker access (used by the web UI)."""
    cfgs = load_node_files(os.path.join(root, "nodes"))
    if name not in cfgs or cfgs[name].get("GLUETAIL_TYPE", "vpn") != "vpn":
        raise GluetailError(f"unknown VPN node '{name}'")
    cfg = cfgs[name]
    return Node(
        name=name, container=f"gluetail-gluetun-{name}", state="unknown", host=f"gluetail-gluetun-{name}",
        provider=cfg.get("VPN_SERVICE_PROVIDER", ""), free_only=cfg.get("FREE_ONLY", "").lower() in TRUTHY,
        working_dir=root, servers_json=os.path.join(data_dir, name, "gluetun", "servers.json"),
    )


def selection_to_items(selection):
    items = []
    for key, value in selection.items():
        if isinstance(value, bool):
            items.append(f"{key}={'on' if value else 'off'}")
        elif isinstance(value, list) and all(isinstance(v, str) for v in value):
            items.append(f"{key}={','.join(value)}")
        else:
            raise GluetailError(f"bad value for '{key}'")
    return items


STATIC_FILES = {
    "app.js": "text/javascript; charset=utf-8",
    "style.css": "text/css; charset=utf-8",
    "fonts/jetbrains-mono-400.woff2": "font/woff2",
    "fonts/jetbrains-mono-700.woff2": "font/woff2",
}
SECURITY_HEADERS = {
    "Content-Security-Policy": "default-src 'self'; frame-ancestors 'none'",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "no-referrer",
    "Cache-Control": "no-store",
}


MAX_BODY = 65536
LOOPBACK_HOSTS = {"localhost", "127.0.0.1", "::1"}


def host_without_port(value):
    value = (value or "").strip().lower()
    if value.startswith("["):  # [::1]:8421
        return value[1:].split("]", 1)[0]
    return value.rsplit(":", 1)[0] if value.count(":") == 1 else value


class App:
    """Request handling for the web UI, kept free of sockets so it can be unit-tested."""

    def __init__(self, root, data_dir, allowed_users=None, allowed_hosts=None):
        self.root, self.data_dir = root, data_dir
        self.allowed_users = {u.strip().lower() for u in (allowed_users or []) if u.strip()}
        # When set, only these Host header names (plus loopback) are served: stops DNS-rebinding pages.
        self.allowed_hosts = {host_without_port(h) for h in (allowed_hosts or []) if h.strip()}
        self.web_dir = os.path.join(root, "web")
        self._locks = {}

    def respond(self, status, payload, ctype="application/json", **extra):
        body = payload if isinstance(payload, bytes) else json.dumps(payload).encode()
        return status, {"Content-Type": ctype, **SECURITY_HEADERS, **extra}, body

    def handle(self, method, path, headers, body=b""):
        headers = {k.lower(): v for k, v in headers.items()}
        path = path.split("?", 1)[0]
        if self.allowed_hosts and host_without_port(headers.get("host")) not in self.allowed_hosts | LOOPBACK_HOSTS:
            print(f"rejected request for Host '{headers.get('host')}' (not in GLUETAIL_UI_HOSTS)", file=sys.stderr)
            return self.respond(403, {"error": "host not allowed"})
        if self.allowed_users and headers.get("tailscale-user-login", "").lower() not in self.allowed_users:
            return self.respond(403, {"error": "not allowed"})
        try:
            if method == "GET" and path in ("/", "/index.html"):
                return self.respond(200, self._read_static("index.html"), "text/html; charset=utf-8")
            if method == "GET" and path.startswith("/static/") and path[8:] in STATIC_FILES:
                cache = {"Cache-Control": "public, max-age=86400"} if path.endswith(".woff2") else {}
                return self.respond(200, self._read_static(path[8:]), STATIC_FILES[path[8:]], **cache)
            if method == "GET" and path == "/api/me":
                return self.respond(200, {"user": headers.get("tailscale-user-login")})
            if method == "GET" and path == "/api/nodes":
                return self.respond(200, self.list_nodes())
            parts = path.strip("/").split("/")
            if len(parts) == 4 and parts[:2] == ["api", "nodes"]:
                name, action = parts[2], parts[3]
                if method == "GET" and action == "options":
                    return self.respond(200, get_options(self.node(name)))
                if method == "POST" and action in ("preview", "set"):
                    if not headers.get("content-type", "").startswith("application/json"):
                        return self.respond(415, {"error": "send application/json"})
                    payload = json.loads(body or b"{}")
                    selection = payload.get("selection") if isinstance(payload, dict) else None
                    if not isinstance(selection, dict):
                        raise GluetailError("body must be {\"selection\": {...}}")
                    return self.respond(200, self.preview(name, selection) if action == "preview"
                                        else self.apply(name, selection))
            return self.respond(404, {"error": "not found"})
        except GluetailError as e:
            return self.respond(409 if "busy" in str(e) else 400, {"error": str(e)})
        except ValueError:
            return self.respond(400, {"error": "invalid JSON"})
        except Exception as e:  # keep the server up; details go to the log, not the client
            print(f"internal error on {method} {path}: {e!r}", file=sys.stderr)
            return self.respond(500, {"error": "internal error"})

    def _read_static(self, fname):
        with open(os.path.join(self.web_dir, fname), "rb") as f:
            return f.read()

    def node(self, name):
        return node_from_files(self.root, self.data_dir, name)

    def list_nodes(self):
        rows = []
        for r in summarize_nodes(load_node_files(os.path.join(self.root, "nodes")), {}):
            r.pop("state")
            if r["type"] == "vpn":
                node = self.node(r["node"])
                r.update({k: v for k, v in node_status(node).items() if k not in ("node", "provider")})
                try:
                    r["plan"] = get_options(node)["plan"]
                except GluetailError:
                    pass
            rows.append(r)
        return rows

    def preview(self, name, selection):
        servers, facets, unsupported, _, free_plan = node_view(self.node(name))
        known = {f["key"] for f in facets if f["kind"] != "plan"}
        clean = {k: v for k, v in selection.items() if k in known}
        pruned, removed = prune_selection(servers, facets, unsupported, clean, free_plan)
        opts = compute_options(servers, facets, unsupported, pruned, free_plan)
        opts["pruned"] = removed
        return opts

    def apply(self, name, selection):
        lock = self._locks.setdefault(name, threading.Lock())
        if not lock.acquire(blocking=False):
            raise GluetailError(f"{name}: busy, another change is in progress")
        try:
            return set_filters(self.node(name), selection_to_items(selection))
        finally:
            lock.release()


def make_handler(app):
    class Handler(BaseHTTPRequestHandler):
        timeout = 15  # seconds per socket read, so a stalled client cannot pin a thread

        def _reject(self, status, message):
            payload = json.dumps({"error": message}).encode()
            self.send_response(status)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(payload)))
            self.send_header("Connection", "close")
            self.end_headers()
            self.wfile.write(payload)
            self.close_connection = True

        def _serve(self, method):
            try:
                length = int(self.headers.get("Content-Length") or 0)
            except ValueError:
                return self._reject(400, "invalid Content-Length")
            if length < 0:
                return self._reject(400, "invalid Content-Length")
            if length > MAX_BODY:
                return self._reject(413, "request too large")
            body = self.rfile.read(length) if length else b""
            status, headers, payload = app.handle("GET" if method == "HEAD" else method, self.path,
                                                  dict(self.headers), body)
            self.send_response(status)
            for k, v in headers.items():
                self.send_header(k, v)
            self.send_header("Content-Length", str(len(payload)))
            self.end_headers()
            if method != "HEAD":
                self.wfile.write(payload)

        def do_GET(self):
            self._serve("GET")

        def do_HEAD(self):
            self._serve("HEAD")

        def do_POST(self):
            self._serve("POST")

        def log_message(self, fmt, *a):
            print(f"{self.client_address[0]} {fmt % a}", file=sys.stderr)

    return Handler


def is_loopback(address):
    host = address.rsplit(":", 1)[0] if address.count(":") == 1 or address.startswith("[") else address
    return host.strip("[]") in ("127.0.0.1", "localhost", "::1")


def open_access_warning(users, published):
    """Warn only when anyone who can reach the page is allowed and the port is not loopback-only."""
    if users or is_loopback(published):
        return None
    return (f"warning: no user allowlist (GLUETAIL_UI_USERS) and the UI is published on {published}: anyone who "
            "can reach it can change VPN settings. Put it behind tailscale serve or an authenticating proxy.")


def cmd_serve(args):
    users = [u for u in (args.users or os.environ.get("GLUETAIL_UI_USERS", "")).split(",") if u.strip()]
    hosts = [h for h in (args.hosts or os.environ.get("GLUETAIL_UI_HOSTS", "")).split(",") if h.strip()]
    app = App(args.root, args.data_dir, users, hosts)
    if users and not hosts:
        print("note: GLUETAIL_UI_HOSTS is not set; set it to the name you reach the UI by (e.g. your "
              "<host>.<tailnet>.ts.net) to also block DNS-rebinding requests.", file=sys.stderr)
    # inside a container the bind is 0.0.0.0; the compose file tells us where it is published on the host
    published = os.environ.get("GLUETAIL_UI_PUBLISHED") or args.bind
    warning = open_access_warning(users, published)
    if warning:
        print(warning, file=sys.stderr)
    httpd = ThreadingHTTPServer((args.bind, args.port), make_handler(app))
    print(f"gluetail UI on http://{args.bind}:{args.port} (nodes: {args.root}/nodes; "
          + (f"{len(users)} allowed login(s)" if users else "no login restriction") + ")", file=sys.stderr)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


def cmd_status(args):
    rows = [node_status(n) for n in discover_nodes()]
    if args.json:
        print(json.dumps(rows, indent=2))
        return 0
    if not rows:
        print("no gluetail VPN nodes found (is the stack up?)")
        return 1
    for r in rows:
        where = ", ".join(x for x in (r.get("city"), r.get("country")) if x)
        if not where:
            where = "(IP lookup pending)" if r.get("vpn") == "running" else "-"
        print(f"{r['node']:<12} container={r['container']:<9} vpn={r.get('vpn', '?'):<8} "
              f"ip={r.get('public_ip') or '-':<16} {where}" + (f"  [{r['error']}]" if "error" in r else ""))
    return 0


def cmd_countries(args):
    for c in node_countries(node_from_args(args)):
        print(c)
    return 0


def _print_set_result(res, args):
    if args.json:
        print(json.dumps(res, indent=2))
    elif res["unchanged"]:
        print(f"{res['node']}: already set that way, nothing changed")
    else:
        note = f"saved to nodes/{res['node']}.env" if res["persisted"] else "not saved (reverts on recreate)"
        if res["verified"]:
            print(f"{res['node']}: now exiting via {res['city']}, {res['country']} ({res['public_ip']}); {note}")
        else:
            print(f"{res['node']}: applied and the VPN is running, but the exit location could not be verified "
                  f"(gluetun's public-IP lookup is not responding); {note}")


def cmd_set(args):
    _print_set_result(set_filters(node_from_args(args), args.filters, persist=not args.no_persist,
                                  timeout=args.timeout), args)
    return 0


def cmd_set_country(args):
    _print_set_result(set_filters(node_from_args(args), ["countries=" + ",".join(args.country)],
                                  persist=not args.no_persist, timeout=args.timeout), args)
    return 0


def cmd_options(args):
    node = node_from_args(args)
    opts = get_options(node)
    if args.json:
        print(json.dumps(opts, indent=2))
        return 0
    print(f"{node.name} ({node.provider}, {opts['plan']} plan): {opts['match_count']} matching servers")
    for e in opts["facets"]:
        if e["kind"] == "multi":
            chosen = {v.lower() for v in e["selected"]}
            items = " ".join(("*" if o["value"].lower() in chosen else "") + f"{o['value'].replace(' ', '_')}({o['count']})"
                             for o in e["options"])
            print(f"  {e['key']:<18} {items or '-'}")
        else:
            state = "on" if e["selected"] else "off"
            why = f"  [{e['disabled_reason']}]" if e.get("disabled_reason") else f"  ({e['count']} servers)"
            print(f"  {e['key']:<18} {state}{why}")
    if opts["unsupported"]:
        print(f"  (server attributes without a control yet: {', '.join(opts['unsupported'])})")
    print("change with: gluetail set <node> key=value[,value] ...   (e.g. countries=Japan cities=Tokyo)")
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(prog="gluetail", description=__doc__.split("\n\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("status", help="show every VPN node's state and exit location")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_status)
    s = sub.add_parser("serve", help="run the web UI (mobile-friendly page on top of the same logic)")
    s.add_argument("--root", default=SCRIPT_DIR, help="directory containing nodes/ and web/")
    s.add_argument("--data-dir", default=os.environ.get("GLUETAIL_DATA_DIR", os.path.join(SCRIPT_DIR, "data")),
                   help="directory with <node>/gluetun/servers.json")
    s.add_argument("--bind", default="127.0.0.1")
    s.add_argument("--port", type=int, default=8421)
    s.add_argument("--users", help="comma-separated Tailscale logins allowed (default: $GLUETAIL_UI_USERS)")
    s.add_argument("--hosts", help="comma-separated Host names to serve (default: $GLUETAIL_UI_HOSTS)")
    s.set_defaults(fn=cmd_serve)
    s = sub.add_parser("up", help="render, `docker compose up -d`, then recreate containers attached to replaced nodes")
    s.add_argument("--force-recreate", action="store_true", help="recreate every gluetail container")
    s.add_argument("--no-dependents", action="store_true", help="do not recreate attached containers afterwards")
    s.add_argument("--dry-run", action="store_true", help="show what would run, change nothing")
    s.add_argument("--root", default=SCRIPT_DIR, help=argparse.SUPPRESS)
    s.set_defaults(fn=cmd_up)
    s = sub.add_parser("render", help="generate docker-compose.yml from nodes/*.env")
    s.add_argument("--root", default=SCRIPT_DIR, help=argparse.SUPPRESS)
    s.set_defaults(fn=cmd_render)
    s = sub.add_parser("nodes", help="list configured nodes and their state")
    s.add_argument("--json", action="store_true")
    s.add_argument("--root", default=SCRIPT_DIR, help=argparse.SUPPRESS)
    s.set_defaults(fn=cmd_nodes)
    s = sub.add_parser("dependents", help="list containers attached to a node's network namespace")
    s.add_argument("node", nargs="?", help="node name or tailnet name (optional if there is one VPN node)")
    s.add_argument("--json", action="store_true")
    s.add_argument("--root", default=SCRIPT_DIR, help=argparse.SUPPRESS)
    s.set_defaults(fn=cmd_dependents)
    s = sub.add_parser("countries", help="list countries a node can use")
    s.add_argument("node", nargs="?", help="node name or tailnet name (optional if there is one VPN node)")
    s.add_argument("--root", default=SCRIPT_DIR, help=argparse.SUPPRESS)
    s.set_defaults(fn=cmd_countries)
    s = sub.add_parser("options", help="show the filters a node supports and what each can still be set to")
    s.add_argument("node", nargs="?", help="node name or tailnet name (optional if there is one VPN node)")
    s.add_argument("--json", action="store_true")
    s.add_argument("--root", default=SCRIPT_DIR, help=argparse.SUPPRESS)
    s.set_defaults(fn=cmd_options)
    s = sub.add_parser("set", help="change filters, e.g. set proton countries=Japan cities=Tokyo")
    s.add_argument("node", help="node name or tailnet name")
    s.add_argument("filters", nargs="+", metavar="key=value")
    s.add_argument("--no-persist", action="store_true", help="do not save the choice to the node file")
    s.add_argument("--timeout", type=int, default=90)
    s.add_argument("--json", action="store_true")
    s.add_argument("--root", default=SCRIPT_DIR, help=argparse.SUPPRESS)
    s.set_defaults(fn=cmd_set)
    s = sub.add_parser("set-country", help="shortcut for: set <node> countries=...")
    s.add_argument("node", help="node name or tailnet name, see `gluetail nodes`")
    s.add_argument("country", nargs="+")
    s.add_argument("--root", default=SCRIPT_DIR, help=argparse.SUPPRESS)
    s.add_argument("--no-persist", action="store_true", help="do not save the choice to the node file")
    s.add_argument("--timeout", type=int, default=90)
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_set_country)
    args = p.parse_args(argv)
    try:
        return args.fn(args)
