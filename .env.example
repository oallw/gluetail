# Copy to .env. Install-level settings only; nothing here is secret.
# Per-node settings (provider, countries, hostname) live in nodes/<name>.env.

# Which nodes to run (comma-separated node names = nodes/<name>.env).
COMPOSE_PROFILES=direct

# Where node state is stored. Must persist across `compose down`, otherwise every
# restart registers a new node in your tailnet.
GLUETAIL_DATA_DIR=./data

# File containing TS_AUTHKEY=... (secret; keep it out of git).
GLUETAIL_TS_ENV=./secrets/tailscale.env

# Image tags.
TAILSCALE_TAG=stable
GLUETUN_TAG=latest

# Timezone for gluetun logs.
TZ=UTC
