# Copy to .env. Install-level settings only; nothing here is secret.
# Per-node settings (provider, countries, hostname) live in nodes/<name>.env.

# Which nodes to run (comma-separated node names = nodes/<name>.env).
COMPOSE_PROFILES=direct

# Where node state is stored. Must persist across `compose down`, otherwise every
# restart registers a new node in your tailnet.
GLUETAIL_DATA_DIR=./data

# File containing TS_AUTHKEY=... (secret; keep it out of git).
GLUETAIL_TS_ENV=./secrets/tailscale.env

# Image versions this project was tested with. Bump deliberately and re-test (gluetun in particular:
# gluetail depends on its firewall and control API; see the comment in templates/header.yml).
TAILSCALE_TAG=v1.102.5
#GLUETUN_IMAGE=qmcgaw/gluetun:latest

# Timezone for gluetun logs.
TZ=UTC

# Web UI (profile "ui"): where the host publishes it, and which Tailscale logins may use it
# (comma-separated; needs `tailscale serve` in front, which sets the identity header).
GLUETAIL_UI_BIND=127.0.0.1:8421
GLUETAIL_UI_USERS=
# Host names the UI answers to (comma-separated, besides localhost): your <host>.<tailnet>.ts.net.
# Blocks DNS-rebinding pages; strongly recommended together with GLUETAIL_UI_USERS.
GLUETAIL_UI_HOSTS=
